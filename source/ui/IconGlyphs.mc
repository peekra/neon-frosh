import Toybox.Lang;

//! Characters of the icon font Icons (resources-round-*/fonts, generated by design/drafts/fonts/make_fonts.swift from
//! the SVG files in design/drafts/fonts/icons). Keep this table in step with the mapping in that script.
//! Weather: WeatherIcons; battery and Bluetooth: vector drawing in FaceRenderer (design/battery_bluetooth.svg).
module IconGlyphs {
    // Glyph of each data kind (index = DataKind.*); "" = no glyph (off, weather: WeatherIcons, date: month text)
    const KIND_GLYPHS = [
        "", "", "I", "A", "C", "C", "B", "D", "E", "F", "G", "H", "J", ""
    ] as Array<String>;
    //  I body-battery (BODY_BATTERY)   A heart (HEART_RATE)   C flame (ACTIVE_CAL, CALORIES)   B steps (STEPS)
    //  D run (RUN_KM)   E bike (BIKE_KM)   F swim (SWIM_M)   G climb (CLIMB_H)   H training (TRAINING_H)
    //  J vo2max (VO2MAX)

    //! Glyph of a data kind, "" for none.
    function forKind(kind as Number) as String {
        if (kind < 0 || kind >= KIND_GLYPHS.size()) {
            return "";
        }
        return KIND_GLYPHS[kind];
    }
}
