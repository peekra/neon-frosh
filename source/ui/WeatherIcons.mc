import Toybox.Graphics;
import Toybox.Lang;

// The seven weather icons as small tables of drawing instructions in a 100 x 100 unit box (centered,
// y down). The tables are generated by design/drafts/weather_icons.py (clean ink cloud outline, details in colour 1).
// Two colours: colour 1 (UiColors.color1, the generated tables call it ACCENT) and ink; clouds that hide a sun are
// filled with the colour behind the icon (background, or the panel fill in a panel).
// Drawing does not allocate (the fill polygon array is built once).
module WeatherIcons {
    // Instructions, each followed by its arguments
    const OP_END = 0;
    const OP_COLOR = 1;    // ACCENT, INK or BG
    const OP_PEN = 2;      // width in tenths of a unit; pixels = max(1, round(w * size / 1000))
    const OP_LINE = 3;     // x1, y1, x2, y2
    const OP_FLINE = 4;    // like OP_LINE, skipped on small icons (size < SMALL_SIZE)
    const OP_POLY = 5;     // n, x, y ... : open polyline
    const OP_CLOSED = 6;   // n, x, y ... : closed outline
    const OP_SHAPE = 7;    // n, x, y ... : filled with BG, then closed outline
    const OP_RING = 8;     // x, y, r
    const OP_DISC = 9;     // x, y, r
    const ACCENT = 0;
    const INK = 1;
    const BG = 2;
    const SMALL_SIZE = 40;

    var _fill as Array<Graphics.Point2D> or Null = null;

    // BEGIN GENERATED (design/drafts/weather_icons.py, do not edit)
    const SUN = [
        OP_COLOR, ACCENT,
        OP_DISC, 0, 0, 20,
        OP_PEN, 110,
        OP_LINE, 31, 0, 45, 0,
        OP_LINE, 22, 22, 32, 32,
        OP_LINE, 0, 31, 0, 45,
        OP_LINE, -22, 22, -32, 32,
        OP_LINE, -31, 0, -45, 0,
        OP_LINE, -22, -22, -32, -32,
        OP_LINE, 0, -31, 0, -45,
        OP_LINE, 22, -22, 32, -32,
        OP_END
    ] as Array<Number>;
    const PARTLY = [
        OP_COLOR, ACCENT,
        OP_DISC, -16, -16, 17,
        OP_PEN, 110,
        OP_LINE, -34, 2, -42, 10,
        OP_LINE, -42, -16, -53, -16,
        OP_LINE, -34, -34, -42, -42,
        OP_LINE, -16, -42, -16, -53,
        OP_LINE, 2, -34, 10, -42,
        OP_COLOR, INK,
        OP_PEN, 110,
        OP_SHAPE, 40, 48, 14, 46, 21, 41, 26, 33, 28, 25, 28, 20, 28, 16, 28, 13, 28, 10, 28, 8, 28, 6, 28, 4, 28, 2, 28, -1, 28, -4, 28, -8, 28, -13, 28, -21, 28, -29, 26, -35, 21, -37, 15, -37, 8, -34, 2, -28, -3, -20, -4, -18, -10, -16, -15, -12, -20, -7, -24, -1, -27, 6, -28, 13, -27, 19, -24, 24, -20, 28, -15, 30, -10, 31, -4, 37, -1, 43, 2, 47, 8,
        OP_END
    ] as Array<Number>;
    const CLOUDY = [
        OP_COLOR, INK,
        OP_PEN, 110,
        OP_SHAPE, 40, 49, 16, 47, 23, 41, 29, 31, 32, 22, 32, 16, 32, 12, 32, 8, 32, 5, 32, 2, 32, 0, 32, -2, 32, -5, 32, -8, 32, -12, 32, -16, 32, -22, 32, -31, 32, -41, 29, -47, 23, -50, 16, -50, 8, -46, 1, -39, -4, -30, -6, -28, -12, -25, -19, -21, -24, -15, -29, -8, -32, 0, -33, 8, -32, 15, -29, 21, -24, 25, -19, 28, -12, 29, -5, 36, -2, 43, 2, 48, 8,
        OP_END
    ] as Array<Number>;
    const RAIN = [
        OP_COLOR, INK,
        OP_PEN, 110,
        OP_SHAPE, 40, 44, -5, 42, 1, 37, 7, 28, 9, 19, 9, 14, 9, 10, 9, 7, 9, 5, 9, 2, 9, 0, 9, -2, 9, -5, 9, -7, 9, -10, 9, -14, 9, -19, 9, -28, 9, -37, 7, -42, 1, -45, -5, -45, -12, -41, -19, -35, -23, -27, -25, -25, -30, -23, -36, -18, -42, -13, -46, -7, -48, 0, -50, 7, -48, 13, -46, 18, -42, 23, -36, 25, -30, 26, -24, 32, -22, 39, -18, 43, -12,
        OP_COLOR, ACCENT,
        OP_PEN, 110,
        OP_LINE, -18, 26, -24, 46,
        OP_LINE, 2, 26, -4, 46,
        OP_LINE, 22, 26, 16, 46,
        OP_END
    ] as Array<Number>;
    const SNOW = [
        OP_COLOR, INK,
        OP_PEN, 110,
        OP_SHAPE, 40, 44, -5, 42, 1, 37, 7, 28, 9, 19, 9, 14, 9, 10, 9, 7, 9, 5, 9, 2, 9, 0, 9, -2, 9, -5, 9, -7, 9, -10, 9, -14, 9, -19, 9, -28, 9, -37, 7, -42, 1, -45, -5, -45, -12, -41, -19, -35, -23, -27, -25, -25, -30, -23, -36, -18, -42, -13, -46, -7, -48, 0, -50, 7, -48, 13, -46, 18, -42, 23, -36, 25, -30, 26, -24, 32, -22, 39, -18, 43, -12,
        OP_COLOR, ACCENT,
        OP_DISC, -20, 32, 8,
        OP_DISC, 2, 42, 8,
        OP_DISC, 24, 32, 8,
        OP_END
    ] as Array<Number>;
    const THUNDER = [
        OP_COLOR, INK,
        OP_PEN, 110,
        OP_SHAPE, 40, 44, -5, 42, 1, 37, 7, 28, 9, 19, 9, 14, 9, 10, 9, 7, 9, 5, 9, 2, 9, 0, 9, -2, 9, -5, 9, -7, 9, -10, 9, -14, 9, -19, 9, -28, 9, -37, 7, -42, 1, -45, -5, -45, -12, -41, -19, -35, -23, -27, -25, -25, -30, -23, -36, -18, -42, -13, -46, -7, -48, 0, -50, 7, -48, 13, -46, 18, -42, 23, -36, 25, -30, 26, -24, 32, -22, 39, -18, 43, -12,
        OP_COLOR, ACCENT,
        OP_PEN, 110,
        OP_POLY, 4, 8, 18, -8, 34, 10, 34, -6, 50,
        OP_END
    ] as Array<Number>;
    const SHOWERS = [
        OP_COLOR, ACCENT,
        OP_DISC, -18, -22, 15,
        OP_PEN, 110,
        OP_LINE, -34, -6, -41, 1,
        OP_LINE, -41, -22, -51, -22,
        OP_LINE, -34, -38, -41, -45,
        OP_LINE, -18, -45, -18, -55,
        OP_LINE, -2, -38, 5, -45,
        OP_COLOR, INK,
        OP_PEN, 110,
        OP_SHAPE, 40, 45, 2, 43, 8, 39, 13, 31, 15, 23, 15, 19, 15, 15, 15, 12, 15, 10, 15, 8, 15, 6, 15, 4, 15, 2, 15, 0, 15, -3, 15, -7, 15, -11, 15, -19, 15, -27, 13, -31, 8, -34, 2, -33, -4, -31, -10, -25, -14, -17, -15, -16, -20, -14, -25, -10, -30, -6, -34, 0, -36, 6, -37, 12, -36, 18, -34, 22, -30, 26, -25, 28, -20, 29, -14, 34, -12, 40, -9, 44, -4,
        OP_COLOR, ACCENT,
        OP_PEN, 110,
        OP_LINE, -10, 28, -16, 46,
        OP_LINE, 8, 28, 2, 46,
        OP_LINE, 26, 28, 20, 46,
        OP_END
    ] as Array<Number>;
    // Index = WeatherKind.SUN .. SHOWERS
    const SHAPES = [SUN, PARTLY, CLOUDY, RAIN, SNOW, THUNDER, SHOWERS] as Array<Array<Number>>;
    const FILL_POINTS = 40;   // largest OP_SHAPE polygon
    // END GENERATED

    // Draws the icon of a WeatherKind value centered on (cx, cy); WeatherKind.NONE draws nothing. back is the colour
    // behind the icon (fills the cloud that hides the sun).
    function draw(dc as Graphics.Dc, kind as Number, cx as Number, cy as Number, size as Number, back as Number) as Void {
        if (kind < 0 || kind >= SHAPES.size()) {
            return;
        }
        if (_fill == null) {
            var pts = new Array<Graphics.Point2D>[FILL_POINTS];
            for (var k = 0; k < FILL_POINTS; k++) {
                pts[k] = [0, 0] as Graphics.Point2D;
            }
            _fill = pts;
        }
        var ops = SHAPES[kind];
        var small = size < SMALL_SIZE;
        var color = UiColors.color1;
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.setPenWidth(1);
        var i = 0;
        while (ops[i] != OP_END) {
            var op = ops[i];
            if (op == OP_COLOR) {
                var c = ops[i + 1];
                color = c == ACCENT ? UiColors.color1 : (c == INK ? UiColors.ink : back);
                dc.setColor(color, Graphics.COLOR_TRANSPARENT);
                i += 2;
            } else if (op == OP_PEN) {
                var p = (ops[i + 1] * size + 500) / 1000;
                dc.setPenWidth(p < 1 ? 1 : p);
                i += 2;
            } else if (op == OP_LINE || op == OP_FLINE) {
                if (!(small && op == OP_FLINE)) {
                    dc.drawLine(cx + ops[i + 1] * size / 100, cy + ops[i + 2] * size / 100,
                        cx + ops[i + 3] * size / 100, cy + ops[i + 4] * size / 100);
                }
                i += 5;
            } else if (op == OP_RING || op == OP_DISC) {
                var x = cx + ops[i + 1] * size / 100;
                var y = cy + ops[i + 2] * size / 100;
                var r = ops[i + 3] * size / 100;
                if (op == OP_RING) {
                    dc.drawCircle(x, y, r);
                } else {
                    dc.fillCircle(x, y, r < 1 ? 1 : r);
                }
                i += 4;
            } else {
                var n = ops[i + 1];
                var f = _fill as Array<Graphics.Point2D>;
                if (op == OP_SHAPE) {
                    for (var k = 0; k < n; k++) {
                        f[k][0] = cx + ops[i + 2 + 2 * k] * size / 100;
                        f[k][1] = cy + ops[i + 3 + 2 * k] * size / 100;
                    }
                    dc.setColor(back, Graphics.COLOR_TRANSPARENT);
                    dc.fillPolygon(f);
                    dc.setColor(color, Graphics.COLOR_TRANSPARENT);
                }
                var px = cx + ops[i + 2] * size / 100;
                var py = cy + ops[i + 3] * size / 100;
                var fx = px;
                var fy = py;
                for (var k = 1; k < n; k++) {
                    var qx = cx + ops[i + 2 + 2 * k] * size / 100;
                    var qy = cy + ops[i + 3 + 2 * k] * size / 100;
                    dc.drawLine(px, py, qx, qy);
                    px = qx;
                    py = qy;
                }
                if (op != OP_POLY) {
                    dc.drawLine(px, py, fx, fy);
                }
                i += 2 + 2 * n;
            }
        }
        dc.setPenWidth(1);
    }
}
