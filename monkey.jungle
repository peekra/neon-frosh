project.manifest = manifest.xml

# Unit tests live in tests/. Everything there must carry the (:test) annotation,
# so it is only compiled into builds made with -t (--unit-test).
base.sourcePath = source;tests

# Display type and climbing, selected at compile time. Exactly one annotation of each pair stays in a build:
#   (:mip) / (:amoled)     display technology (DisplayType.IS_MIP)
#   (:climb) / (:noclimb)  the watch can record climbing (DeviceSports.HAS_CLIMBING)
# A device line replaces the base value, so every line names both pairs.
base.excludeAnnotations = mip;noclimb
fenix7.excludeAnnotations = amoled;noclimb
fenix7s.excludeAnnotations = amoled;noclimb
fenix7x.excludeAnnotations = amoled;noclimb
fenix7pro.excludeAnnotations = amoled;noclimb
fenix7spro.excludeAnnotations = amoled;noclimb
fenix7xpro.excludeAnnotations = amoled;noclimb
fenix7pronowifi.excludeAnnotations = amoled;noclimb
fenix7xpronowifi.excludeAnnotations = amoled;noclimb
fenix8solar47mm.excludeAnnotations = amoled;noclimb
fenix8solar51mm.excludeAnnotations = amoled;noclimb
fenix9prosolar47mm.excludeAnnotations = amoled;noclimb
fenix9prosolar51mm.excludeAnnotations = amoled;noclimb
fr255.excludeAnnotations = amoled;noclimb
fr255m.excludeAnnotations = amoled;noclimb
fr255s.excludeAnnotations = amoled;noclimb
fr255sm.excludeAnnotations = amoled;noclimb
fr955.excludeAnnotations = amoled;noclimb
enduro3.excludeAnnotations = amoled;noclimb
enduro4.excludeAnnotations = amoled;noclimb
vivoactive5.excludeAnnotations = mip;climb
instinct3amoled45mm.excludeAnnotations = mip;noclimb
instinct3amoled50mm.excludeAnnotations = mip;noclimb
fr165.excludeAnnotations = mip;climb
fr165m.excludeAnnotations = mip;climb
fr170.excludeAnnotations = mip;climb
fr170m.excludeAnnotations = mip;climb
fr70.excludeAnnotations = mip;climb
vivoactive6.excludeAnnotations = mip;climb

# Phone settings (Connect IQ app / Garmin Express), one of two variants per device:
#   resources-settings-climb    with the list entry "Climbing h/week"
#   resources-settings-noclimb  without it (the devices that exclude "climb" above)
# Every device appends its variant to its own default resource path, so the resolution folders
# (resources-round-<W>x<H>) stay in.
fr165.resourcePath = $(fr165.resourcePath);resources-settings-noclimb
fr165m.resourcePath = $(fr165m.resourcePath);resources-settings-noclimb
fr265.resourcePath = $(fr265.resourcePath);resources-settings-climb
fr265s.resourcePath = $(fr265s.resourcePath);resources-settings-climb
fr965.resourcePath = $(fr965.resourcePath);resources-settings-climb
fr970.resourcePath = $(fr970.resourcePath);resources-settings-climb
